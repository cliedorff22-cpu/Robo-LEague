{
  "schema": "arenas/1",
  "_comment": "Where the fights happen. data/arena.json is the box itself (floor, walls, physics, cameras) and its hazards are the Classic layout. A LAYOUT swaps the hazards; a VENUE is the building round the box - stands, crowd, lights, screens - and which layouts it runs. js/logic/arenas.js puts them together; nothing about either lives in code.",

  "layouts": {
    "classic": {
      "name": "The Box",
      "blurb": "Pulverizers in two corners, a screw on every wall, six killsaws for the last minute.",
      "_hazards": "No `hazards`: the classic layout is data/arena.json's own list."
    },

    "hammer_alley": {
      "name": "Hammer Alley",
      "blurb": "A pulverizer in every corner and screws behind both starting squares. Stay out of the corners.",
      "_hazards": "`like` copies a hazard from data/arena.json and overrides what is given, so the tuning stays in one place.",
      "killsaw": { "activeCount": 2 },
      "hazards": [
        { "like": "pulverizer_ne" },
        { "like": "pulverizer_sw" },
        { "like": "pulverizer_ne", "id": "pulverizer_nw", "pos": [-18, 0, -18], "yaw": 45 },
        { "like": "pulverizer_ne", "id": "pulverizer_se", "pos": [18, 0, 18], "yaw": -135 },
        { "like": "screw_west" },
        { "like": "screw_east" },
        { "like": "saw_nw" },
        { "like": "saw_ne" },
        { "like": "saw_sw" },
        { "like": "saw_se" }
      ]
    },

    "sawmill": {
      "name": "The Sawmill",
      "blurb": "Eight killsaws across the floor, four at a time, from a minute forty out. Two pulverizers on the other diagonal.",
      "killsaw": { "deployAtRemainingS": 100, "activeCount": 4, "rotateEveryS": 4 },
      "hazards": [
        { "like": "pulverizer_ne", "id": "pulverizer_nw", "pos": [-18, 0, -18], "yaw": 45 },
        { "like": "pulverizer_ne", "id": "pulverizer_se", "pos": [18, 0, 18], "yaw": -135 },
        { "like": "screw_north" },
        { "like": "screw_south" },
        { "like": "saw_nw", "pos": [-10, 0, -10] },
        { "like": "saw_n" },
        { "like": "saw_ne", "pos": [10, 0, -10] },
        { "like": "saw_nw", "id": "saw_w", "pos": [-11, 0, 0], "yaw": 90 },
        { "like": "saw_nw", "id": "saw_e", "pos": [11, 0, 0], "yaw": 90 },
        { "like": "saw_sw", "pos": [-10, 0, 10] },
        { "like": "saw_s" },
        { "like": "saw_se", "pos": [10, 0, 10] }
      ]
    },

    "the_pit": {
      "name": "The Pit",
      "blurb": "The middle of the floor drops away with a minute left. Anything that goes in is out.",
      "hazards": [
        { "like": "pulverizer_ne" },
        { "like": "pulverizer_sw" },
        { "like": "screw_north" },
        { "like": "screw_south" },
        {
          "id": "pit_center", "type": "pit", "enabled": true, "pos": [0, 0, 0], "yaw": 0,
          "size": [8, 8], "depth": 2.5, "openAtRemainingS": 60, "lowerS": 2.5, "warnS": 4,
          "note": "A square of deck that sinks to `depth` from `openAtRemainingS` and stays down. Lights round the edge flash for `warnS` first. A robot whose body is below the deck is out on the spot (js/sim/referee.js)."
        }
      ]
    },

    "grinder": {
      "name": "The Grinder",
      "blurb": "Two screws on every wall and no hammers. Get shoved anywhere near the edge and it bites.",
      "killsaw": { "activeCount": 2 },
      "hazards": [
        { "like": "screw_west", "id": "screw_west_n", "pos": [-22.3, 0, -10.5] },
        { "like": "screw_west", "id": "screw_west_s", "pos": [-22.3, 0, 10.5] },
        { "like": "screw_east", "id": "screw_east_n", "pos": [22.3, 0, -10.5] },
        { "like": "screw_east", "id": "screw_east_s", "pos": [22.3, 0, 10.5] },
        { "like": "screw_north", "id": "screw_north_w", "pos": [-10.5, 0, -22.3] },
        { "like": "screw_north", "id": "screw_north_e", "pos": [10.5, 0, -22.3] },
        { "like": "screw_south", "id": "screw_south_w", "pos": [-10.5, 0, 22.3] },
        { "like": "screw_south", "id": "screw_south_e", "pos": [10.5, 0, 22.3] },
        { "like": "saw_n" },
        { "like": "saw_s" }
      ]
    }
  },

